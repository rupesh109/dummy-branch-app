ENV_NAME=prod
ENV_FILE=.env.prod

FLASK_ENV=production
LOG_LEVEL=warning

API_PORT=8000
DB_PORT=5434

API_CPU_LIMIT=0.7
API_MEM_LIMIT=2g

DB_VOLUME=db-data-prod
DEV_MOUNT=

POSTGRES_USER=branch
POSTGRES_PASSWORD=prod-super-secret
POSTGRES_DB=microloans_prod

DATABASE_URL=postgresql+psycopg2://branch:prod-super-secret@db:5432/microloans_prod

