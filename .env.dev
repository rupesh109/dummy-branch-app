ENV_NAME=dev
ENV_FILE=.env.dev

FLASK_ENV=development
LOG_LEVEL=debug

API_PORT=8000
DB_PORT=5432

API_CPU_LIMIT=0.5
API_MEM_LIMIT=512m

DB_VOLUME=db-data-dev
DEV_MOUNT=:cached

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=microloans

DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/microloans
