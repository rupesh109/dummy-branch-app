ENV_NAME=staging
ENV_FILE=.env.staging

FLASK_ENV=production
LOG_LEVEL=info

API_PORT=8000
DB_PORT=5433

API_CPU_LIMIT=1
API_MEM_LIMIT=1g

DB_VOLUME=db-data-staging
DEV_MOUNT=

POSTGRES_USER=branch
POSTGRES_PASSWORD=staging-secret
POSTGRES_DB=microloans_staging

DATABASE_URL=postgresql+psycopg2://branch:staging-secret@db:5432/microloans_staging
